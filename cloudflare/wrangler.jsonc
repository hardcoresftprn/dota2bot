{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dota2bot",
  "account_id": "3179282812a11e2369e7bdf2f874d66e",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "ALLOWED_USER_IDS": "" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "dota2bot",
    "database_id": "5722410a-5b80-43dd-bc55-61b965dafd0b"
  }]
}
