# Создать бота: https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=

# На бесплатном Northflank — строка подключения бесплатного PostgreSQL.
# Локально оставить пустым: будет использован SQLite в ./data/bot.sqlite3.
DATABASE_URL=
DB_PATH=./data/bot.sqlite3
CHECK_INTERVAL_SECONDS=600

# Необязательно. Пустое значение = бесплатная сводка по русским данным Valve.
# При подключении OpenAI API его использование оплачивается отдельно.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Пусто = подписаться может любой. Иначе Telegram user ID через запятую.
# В группе проверяется ID пользователя, выполняющего команду, и права администратора.
ALLOWED_USER_IDS=
PORT=8080
